# API
APP_NAME=canal-vegetation-api
API_PREFIX=/api/v1
CORS_ORIGINS=*

# Paths (relative to the backend/ working directory)
DATA_DIR=./data
OUTPUT_DIR=./outputs
MODEL_DIR=./app/models/model_weights
UPLOAD_DIR=./data/uploads
PROJECT_ROOT=./data/projects

# SQLite job store
DATABASE_URL=sqlite:///./data/jobs.db

# Local threaded jobs (Phase 1 default). Set true only if Redis + Celery worker are running.
USE_CELERY=false

# Local file storage
STORAGE_BACKEND=local

# Canal UNet checkpoint filename under MODEL_DIR
# Preferred lines checkpoint is used automatically if present; otherwise this file is used.
CANAL_MODEL_NAME=best_binary_unet_v5.pth
CANAL_MODEL_FALLBACK=best_binary_unet_v5_lines.pth
CANAL_ENCODER=resnet50

# Tiled inference defaults
TILE_SIZE=512
TILE_STEP=384
DOWNSCALE_FACTOR=8
CANAL_THRESHOLD=0.4
CORRIDOR_BUFFER_M=35
